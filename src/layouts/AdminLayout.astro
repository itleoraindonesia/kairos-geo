---
import "../styles/global.css";

type Props = {
  title: string;
  nav?: boolean;
  active?: "dashboard" | "artikel";
};

const { title, nav = false, active = "dashboard" } = Astro.props;
const user = Astro.locals.user;

const navLinkClass = (on: boolean) =>
  `flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-bold transition ${
    on
      ? "bg-white/15 text-white"
      : "text-white/70 hover:bg-white/10 hover:text-white"
  }`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/kairoslogo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-zinc-900 selection:bg-kairos-300/60 selection:text-kairos-950">
    {!nav ? (
      <slot />
    ) : (
      <div class="min-h-screen bg-zinc-50">
        <!-- Backdrop Mobile -->
        <div
          id="sidebar-backdrop"
          class="fixed inset-0 z-40 hidden bg-kairos-950/60 lg:hidden"
          aria-hidden="true"
        ></div>

        <!-- Sidebar -->
        <aside
          id="admin-sidebar"
          aria-label="Navigasi Admin"
          class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col bg-kairos-950 text-white transition-transform duration-200 ease-out lg:translate-x-0"
        >
          <!-- Brand -->
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-5">
            <a href="/admin" class="flex items-center gap-3">
              <div class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-full bg-white/10 ring-1 ring-white/15">
                <img src="/kairoslogo.png" alt="Kairos Geo" class="h-full w-full object-cover" />
              </div>
              <div class="leading-tight">
                <div class="font-display text-base font-extrabold tracking-tight">Kairos Geo</div>
                <div class="text-[11px] text-white/70">Panel Admin</div>
              </div>
            </a>

            <button
              type="button"
              id="close-sidebar"
              aria-label="Tutup menu"
              class="rounded-lg p-1.5 text-white/70 transition hover:bg-white/10 hover:text-white lg:hidden"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
              </svg>
            </button>
          </div>

          <!-- Menu -->
          <nav class="flex-1 space-y-1 px-3 py-5">
            <a
              href="/admin"
              aria-current={active === "dashboard" ? "page" : undefined}
              class={navLinkClass(active === "dashboard")}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0">
                <rect width="7" height="9" x="3" y="3" rx="1" />
                <rect width="7" height="5" x="14" y="3" rx="1" />
                <rect width="7" height="9" x="14" y="12" rx="1" />
                <rect width="7" height="5" x="3" y="16" rx="1" />
              </svg>
              Dashboard
            </a>

            <a
              href="/admin/artikel"
              aria-current={active === "artikel" ? "page" : undefined}
              class={navLinkClass(active === "artikel")}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                <path d="M10 9H8" />
                <path d="M16 13H8" />
                <path d="M16 17H8" />
              </svg>
              Artikel
            </a>
          </nav>

          <!-- User & Logout -->
          <div class="border-t border-white/10 p-4">
            {user?.email && (
              <div class="mb-3 truncate px-1 text-xs text-white/75" title={user.email}>
                {user.email}
              </div>
            )}
            <form method="POST" action="/api/auth/logout">
              <button
                type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-white/15"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                  <polyline points="16 17 21 12 16 7" />
                  <line x1="21" x2="9" y1="12" y2="12" />
                </svg>
                Keluar
              </button>
            </form>
          </div>
        </aside>

        <!-- Wrapper Konten -->
        <div class="lg:pl-64">
          <!-- Header Khusus Mobile -->
          <header class="sticky top-0 z-30 flex items-center justify-between border-b border-zinc-200 bg-white px-4 py-3 lg:hidden">
            <div class="flex items-center gap-3">
              <button
                type="button"
                id="open-sidebar"
                aria-label="Buka menu"
                aria-controls="admin-sidebar"
                aria-expanded="false"
                class="rounded-xl border border-zinc-200 p-2 text-zinc-700 transition hover:bg-zinc-100"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <line x1="4" x2="20" y1="12" y2="12" />
                  <line x1="4" x2="20" y1="6" y2="6" />
                  <line x1="4" x2="20" y1="18" y2="18" />
                </svg>
              </button>
              <span class="font-display text-sm font-extrabold text-zinc-950">Kairos Geo</span>
            </div>
          </header>

          <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:py-10">
            <slot />
          </main>
        </div>
      </div>
    )}

    <script>
      function setupAdminSidebar() {
        const sidebar = document.getElementById("admin-sidebar");
        const backdrop = document.getElementById("sidebar-backdrop");
        const openBtn = document.getElementById("open-sidebar");
        const closeBtn = document.getElementById("close-sidebar");

        if (!sidebar || !backdrop || !openBtn || !closeBtn) return;

        const open = () => {
          sidebar.classList.remove("-translate-x-full");
          backdrop.classList.remove("hidden");
          openBtn.setAttribute("aria-expanded", "true");
          document.body.classList.add("overflow-hidden");
        };

        const close = () => {
          sidebar.classList.add("-translate-x-full");
          backdrop.classList.add("hidden");
          openBtn.setAttribute("aria-expanded", "false");
          document.body.classList.remove("overflow-hidden");
        };

        openBtn.addEventListener("click", open);
        closeBtn.addEventListener("click", close);
        backdrop.addEventListener("click", close);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      }

      setupAdminSidebar();
      document.addEventListener("astro:page-load", setupAdminSidebar);
    </script>
  </body>
</html>