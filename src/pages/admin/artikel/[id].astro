---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../../lib/supabase";

export const prerender = false;

const param = Astro.params.id;
const isEdit = param !== "baru";
const id = Number(param);

if (isEdit && !(Number.isInteger(id) && id > 0)) return Astro.redirect("/admin/artikel");

const [articleRes, categoriesRes] = await Promise.all([
  isEdit
    ? supabaseAdmin.from("articles").select("*").eq("id", id).single()
    : Promise.resolve({ data: null }),
  supabaseAdmin.from("categories").select("id, name").order("name"),
]);

const article: Record<string, any> | null = articleRes.data;
const categories = categoriesRes.data ?? [];

if (isEdit && !article) {
  return Astro.redirect("/admin/artikel?error=" + encodeURIComponent("Artikel tidak ditemukan."));
}

const error = Astro.url.searchParams.get("error");

const card = "rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel";
const label = "mb-1.5 block text-xs font-bold uppercase tracking-wider text-zinc-700";
const input =
  "w-full rounded-xl border border-zinc-200 bg-white px-4 py-3 text-sm text-zinc-900 outline-none transition focus:border-kairos-400 focus:ring-2 focus:ring-kairos-200";
const hint = "mt-1 text-xs text-zinc-400";
---

<AdminLayout title={`${isEdit ? "Edit" : "Tambah"} Artikel | Kairos Geo`} nav active="artikel">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
  <style is:global>
    .ql-toolbar.ql-snow { border-radius: 12px 12px 0 0; border-color: #e4e4e7; background: #fafafa; }
    .ql-container.ql-snow { border-radius: 0 0 12px 12px; border-color: #e4e4e7; font-size: 15px; background: #fff; }
    .ql-editor { min-height: 280px; line-height: 1.7; }
  </style>

  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <div class="h-1 w-20 rounded-full bg-gradient-to-r from-kairos-500 to-kairos-300"></div>
      <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950">
        {isEdit ? "Edit Artikel" : "Tambah Artikel"}
      </h1>
    </div>
    <a href="/admin/artikel" class="text-sm font-bold text-kairos-500 transition hover:text-kairos-700">&larr; Kembali ke daftar</a>
  </div>

  {error && (
    <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 ring-1 ring-red-100">{error}</div>
  )}

  <form
    id="articleForm"
    method="POST"
    action="/api/admin/articles"
    enctype="multipart/form-data"
    data-edit={isEdit ? "1" : "0"}
    class="grid gap-5"
  >
    <input type="hidden" name="_action" value={isEdit ? "update" : "create"} />
    {isEdit && <input type="hidden" name="id" value={article!.id} />}

    <section class={card}>
      <div class="grid gap-5">
        <div>
          <label class={label} for="title">Judul Artikel <span class="text-red-500">*</span></label>
          <input class={input} type="text" id="title" name="title" value={article?.title ?? ""} placeholder="Masukkan judul artikel..." required />
        </div>

        <div>
          <label class={label} for="slug">Slug URL <span class="font-normal normal-case text-zinc-400">(otomatis dari judul)</span></label>
          <input class={input} type="text" id="slug" name="slug" value={article?.slug ?? ""} placeholder="judul-artikel" />
        </div>

        <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <label class={label} for="category_id">Kategori</label>
            <select class={input} id="category_id" name="category_id">
              <option value="">-- Tanpa kategori --</option>
              {categories.map((c) => (
                <option value={c.id} selected={article?.category_id === c.id}>{c.name}</option>
              ))}
            </select>
          </div>
          <label class="flex cursor-pointer items-center gap-2 pb-3 text-sm font-bold text-zinc-800">
            <input type="checkbox" name="is_published" value="1" class="h-4 w-4 accent-kairos-500" checked={article ? article.is_published : true} />
            Publikasikan artikel
          </label>
        </div>
      </div>
    </section>

    <section class={card}>
      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <label class={label} for="cover_image">
            Cover Image {!isEdit && <span class="text-red-500">*</span>}
          </label>
          <input class={input} type="file" id="cover_image" name="cover_image" accept="image/png,image/jpeg,image/webp" required={!isEdit} />
          <p class={hint}>JPG, PNG, atau WEBP. Maksimal 2MB.</p>
          {article?.cover_image && (
            <div class="mt-3 inline-block rounded-xl border border-zinc-200 p-2">
              <div class="mb-1 text-[11px] text-zinc-500">Gambar saat ini:</div>
              <img src={article.cover_image} alt="Cover saat ini" class="h-20 w-32 rounded-lg object-cover" />
            </div>
          )}
        </div>
        <div>
          <label class={label} for="thumbnail_alt">Alt Text Gambar <span class="font-normal normal-case text-zinc-400">(otomatis)</span></label>
          <input class={input} type="text" id="thumbnail_alt" name="thumbnail_alt" value={article?.thumbnail_alt ?? ""} placeholder="Deskripsi gambar untuk SEO..." />
        </div>
      </div>
    </section>

    <section class={card}>
      <label class={label}>Konten Artikel <span class="text-red-500">*</span></label>
      <textarea name="content" id="content" hidden>{article?.content ?? ""}</textarea>
      <div id="quill-editor" set:html={article?.content ?? ""}></div>
    </section>

    <section class={card}>
      <label class={label} for="excerpt">Ringkasan / Excerpt <span class="font-normal normal-case text-zinc-400">(otomatis dari isi artikel)</span></label>
      <textarea class={input} id="excerpt" name="excerpt" rows="3" placeholder="Ringkasan singkat artikel...">{article?.excerpt ?? ""}</textarea>
    </section>

    <section class={card}>
      <h2 class="mb-4 text-base font-extrabold text-zinc-950">Optimasi SEO Google</h2>
      <div class="grid gap-5">
        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <label class={label} for="focus_keyword">Focus Keyword</label>
            <input class={input} type="text" id="focus_keyword" name="focus_keyword" value={article?.focus_keyword ?? ""} placeholder="misal: geomembrane HDPE" />
          </div>
          <div>
            <label class={label} for="meta_title">Meta Title <span class="font-normal normal-case text-zinc-400">(otomatis)</span></label>
            <input class={input} type="text" id="meta_title" name="meta_title" value={article?.meta_title ?? ""} placeholder="Judul halaman untuk Google..." />
          </div>
        </div>

        <div>
          <label class={label} for="meta_description">Meta Description <span class="font-normal normal-case text-zinc-400">(otomatis)</span></label>
          <textarea class={input} id="meta_description" name="meta_description" rows="2" placeholder="Deskripsi yang muncul di hasil pencarian Google...">{article?.meta_description ?? ""}</textarea>
        </div>

        <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <label class={label} for="canonical_url">Canonical URL <span class="font-normal normal-case text-zinc-400">(opsional)</span></label>
            <input class={input} type="url" id="canonical_url" name="canonical_url" value={article?.canonical_url ?? ""} placeholder="https://www.kairosgeo.id/artikel/..." />
          </div>
          <label class="flex cursor-pointer items-center gap-2 pb-3 text-sm font-bold text-zinc-800">
            <input type="checkbox" name="is_indexable" value="1" class="h-4 w-4 accent-kairos-500" checked={article ? article.is_indexable : true} />
            Izinkan Google index
          </label>
        </div>
      </div>
    </section>

    <div class="flex flex-wrap gap-3">
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-kairos-950/20 transition hover:brightness-110"
      >
        {isEdit ? "Perbarui Artikel" : "Simpan Artikel"}
      </button>
      <a
        href="/admin/artikel"
        class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-6 py-3 text-sm font-bold text-zinc-700 transition hover:bg-zinc-50"
      >
        Batal
      </a>
    </div>
  </form>

  <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var form = $('articleForm');
      var title = $('title'), slug = $('slug'), metaTitle = $('meta_title');
      var thumbAlt = $('thumbnail_alt'), excerpt = $('excerpt'), metaDesc = $('meta_description');
      var content = $('content');

      var isEdit = form.dataset.edit === '1';
      var manual = {
        slug: isEdit,
        metaTitle: metaTitle.value !== '',
        thumbAlt: thumbAlt.value !== '',
        excerpt: excerpt.value !== '',
        metaDesc: metaDesc.value !== ''
      };

      var slugify = function (s) {
        return s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      };

      var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Tuliskan isi artikel di sini...',
        modules: {
          toolbar: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            [{ align: [] }],
            [{ list: 'ordered' }, { list: 'bullet' }],
            [{ indent: '-1' }, { indent: '+1' }],
            ['blockquote', 'link'],
            ['clean']
          ]
        }
      });

      var plain = function () { return quill.getText().replace(/\s+/g, ' ').trim(); };

      var sync = function () {
        var t = title.value.trim();
        if (!manual.slug) slug.value = slugify(t);
        if (!manual.metaTitle) metaTitle.value = t ? t + ' | Kairos Geo' : '';
        if (!manual.thumbAlt) thumbAlt.value = t ? 'Gambar ' + t : '';
        var p = plain();
        if (!manual.excerpt) excerpt.value = p.slice(0, 200);
        if (!manual.metaDesc) metaDesc.value = p.slice(0, 155);
      };

      title.addEventListener('input', sync);
      slug.addEventListener('input', function () { manual.slug = slug.value !== ''; });
      metaTitle.addEventListener('input', function () { manual.metaTitle = metaTitle.value !== ''; });
      thumbAlt.addEventListener('input', function () { manual.thumbAlt = thumbAlt.value !== ''; });
      excerpt.addEventListener('input', function () { manual.excerpt = excerpt.value !== ''; });
      metaDesc.addEventListener('input', function () { manual.metaDesc = metaDesc.value !== ''; });

      quill.on('text-change', function () {
        content.value = quill.root.innerHTML;
        sync();
      });

      form.addEventListener('submit', function () {
        content.value = quill.root.innerHTML;
      });

      sync();
    })();
  </script>
</AdminLayout>