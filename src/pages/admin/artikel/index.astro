---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../../lib/supabase";

export const prerender = false;

const { data: articles, error } = await supabaseAdmin
  .from("articles")
  .select("id, title, slug, is_published, published_at, created_at, category:categories(name)")
  .order("created_at", { ascending: false });

const saved = Astro.url.searchParams.get("saved");
const deleted = Astro.url.searchParams.get("deleted");
const err = Astro.url.searchParams.get("error") ?? error?.message;

const fmt = (d?: string | null) =>
  d ? new Date(d).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" }) : "-";
---

<AdminLayout title="Artikel | Kairos Geo" nav active="artikel">
  <div class="flex flex-col justify-between gap-4 border-b border-zinc-200 pb-6 sm:flex-row sm:items-center">
    <div>
      <h1 class="font-display text-2xl font-extrabold tracking-tight text-zinc-950 sm:text-3xl">
        Artikel
      </h1>
      <p class="mt-1 text-sm text-zinc-500">
        {articles ? `${articles.length} artikel tersimpan` : "Daftar artikel website"}
      </p>
    </div>

    <a
      href="/admin/artikel/baru"
      class="inline-flex items-center justify-center rounded-xl bg-kairos-500 px-4 py-2.5 text-sm font-bold text-white transition hover:brightness-110"
    >
      Tambah Artikel
    </a>
  </div>

  {saved && (
    <div role="status" class="mt-5 rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-700 ring-1 ring-green-200/70">
      Artikel berhasil disimpan.
    </div>
  )}
  {deleted && (
    <div role="status" class="mt-5 rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-700 ring-1 ring-green-200/70">
      Artikel berhasil dihapus.
    </div>
  )}
  {err && (
    <div role="alert" class="mt-5 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 ring-1 ring-red-200/70">
      {err}
    </div>
  )}

  <div class="mt-6 overflow-hidden rounded-2xl border border-zinc-200/80 bg-white shadow-panel">
    {!articles || articles.length === 0 ? (
      <div class="px-6 py-14 text-center text-sm text-zinc-500">
        Belum ada artikel. Klik <strong class="font-bold text-zinc-800">Tambah Artikel</strong> untuk mulai menulis.
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-b border-zinc-200 bg-zinc-50 text-xs font-bold uppercase tracking-wider text-zinc-500">
            <tr>
              <th class="px-5 py-3.5">Judul</th>
              <th class="px-5 py-3.5">Kategori</th>
              <th class="px-5 py-3.5">Status</th>
              <th class="px-5 py-3.5">Tanggal</th>
              <th class="px-5 py-3.5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {articles.map((a: any) => (
              <tr class="align-middle transition hover:bg-zinc-50/80">
                <td class="px-5 py-4">
                  <div class="font-bold text-zinc-950">{a.title}</div>
                  <div class="mt-0.5 text-xs text-zinc-400">/artikel/{a.slug}</div>
                </td>
                <td class="px-5 py-4 text-zinc-600">
                  {a.category?.name ?? "-"}
                </td>
                <td class="px-5 py-4">
                  {a.is_published ? (
                    <div class="text-xs font-bold text-green-700">Publik</div>
                  ) : (
                    <div class="text-xs font-semibold text-zinc-500">Draft</div>
                  )}
                </td>
                <td class="px-5 py-4 text-zinc-600">
                  {fmt(a.published_at ?? a.created_at)}
                </td>
                <td class="px-5 py-4">
                  <div class="flex items-center justify-end gap-4">
                    <a
                      href={`/admin/artikel/${a.id}`}
                      class="text-sm font-bold text-kairos-600 transition hover:text-kairos-800"
                    >
                      Edit
                    </a>
                    <form
                      method="POST"
                      action="/api/admin/articles"
                      onsubmit="return confirm('Hapus artikel ini? Tindakan ini tidak bisa dibatalkan.')"
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <input type="hidden" name="id" value={a.id} />
                      <button
                        type="submit"
                        class="text-sm font-bold text-red-600 transition hover:text-red-800"
                      >
                        Hapus
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>