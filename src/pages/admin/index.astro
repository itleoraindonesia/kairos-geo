---
import AdminLayout from "../../layouts/AdminLayout.astro";

export const prerender = false;

const { user } = Astro.locals;
---

<AdminLayout title="Dashboard | Kairos Geo" nav active="dashboard">
  <div class="flex flex-col justify-between gap-4 border-b border-zinc-200 pb-6 sm:flex-row sm:items-center">
    <div>
      <h1 class="font-display text-2xl font-extrabold tracking-tight text-zinc-950 sm:text-3xl">
        Dashboard
      </h1>
      <p class="mt-1 text-sm text-zinc-500">
        Selamat datang{user?.email ? `, ${user.email}` : ""}
      </p>
    </div>

    <a
      href="/admin/artikel"
      class="inline-flex items-center justify-center rounded-xl bg-kairos-500 px-4 py-2.5 text-sm font-bold text-white transition hover:brightness-110"
    >
      Kelola Artikel
    </a>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <a
      href="/admin/artikel"
      class="group flex flex-col justify-between rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-panel transition hover:border-kairos-400"
    >
      <div>
        <h2 class="text-lg font-extrabold text-zinc-950 group-hover:text-kairos-600">
          Artikel
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-zinc-600">
          Tulis, ubah, dan kelola publikasi artikel website.
        </p>
      </div>
      <div class="mt-5 text-sm font-bold text-kairos-600">
        Buka halaman &rarr;
      </div>
    </a>

    <div class="flex flex-col justify-between rounded-2xl border border-zinc-200/80 bg-zinc-50/70 p-6">
      <div>
        <h2 class="text-lg font-extrabold text-zinc-700">
          Kategori
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">
          Atur pengelompokan kategori untuk setiap artikel.
        </p>
      </div>
      <div class="mt-5 text-xs font-semibold text-zinc-400">
        Segera hadir
      </div>
    </div>
  </div>
</AdminLayout>