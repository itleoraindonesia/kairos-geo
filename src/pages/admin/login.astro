---
import AdminLayout from "../../layouts/AdminLayout.astro";

export const prerender = false;
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const error = Astro.url.searchParams.get("error");
---

<AdminLayout title="Login Admin | Kairos Geo">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-kairos-950 px-4 py-8 sm:px-6 lg:py-12">
    <div class="absolute inset-0 hero-grid opacity-40" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/40 to-kairos-950/80" aria-hidden="true"></div>

    <!-- Container Utama: Single column di mobile, 2 kolom di desktop -->
    <div class="relative grid w-full max-w-md overflow-hidden rounded-[28px] border border-white/15 bg-white shadow-panel lg:max-w-4xl lg:grid-cols-12">
      
      <!-- Kolom Kiri: Form Login -->
      <div class="flex flex-col justify-center p-7 sm:p-10 lg:col-span-6">
        <!-- Brand Header -->
        <div class="mb-7 flex items-center gap-3">
          <div class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-kairos-950 ring-1 ring-zinc-200">
            <img src="/kairoslogo.png" alt="Kairos Geo" class="h-full w-full object-cover" />
          </div>
          <div>
            <div class="font-display text-lg font-extrabold leading-tight tracking-tight text-zinc-950">
              Kairos Geo
            </div>
            <div class="text-xs font-medium text-zinc-500">Admin Control Panel</div>
          </div>
        </div>

        <h1 class="font-display text-2xl font-extrabold tracking-tight text-zinc-950">
          Login Admin
        </h1>
        <p class="mt-1 text-sm text-zinc-500">
          Masuk untuk mengelola konten dan katalog website.
        </p>

        {error === "invalid" && (
          <div
            role="alert"
            class="mt-5 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 ring-1 ring-red-100"
          >
            Email atau password salah.
          </div>
        )}
        {error === "forbidden" && (
          <div
            role="alert"
            class="mt-5 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 ring-1 ring-red-100"
          >
            Akun ini tidak punya akses admin.
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="mt-6 grid gap-4">
          <label class="grid gap-1.5 text-sm font-bold text-zinc-800">
            Email
            <input
              type="email"
              name="email"
              required
              autocomplete="username"
              placeholder="admin@kairosgeo.com"
              class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm font-normal text-zinc-900 placeholder:text-zinc-400 outline-none transition focus:border-kairos-400 focus:ring-2 focus:ring-kairos-200"
            />
          </label>

          <div class="grid gap-1.5">
            <label for="password-input" class="text-sm font-bold text-zinc-800">
              Password
            </label>
            <div class="relative">
              <input
                id="password-input"
                type="password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full rounded-xl border border-zinc-200 py-3 pl-4 pr-11 text-sm font-normal text-zinc-900 placeholder:text-zinc-400 outline-none transition focus:border-kairos-400 focus:ring-2 focus:ring-kairos-200"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Tampilkan password"
                aria-pressed="false"
                class="absolute inset-y-0 right-0 flex items-center px-3.5 text-zinc-400 transition hover:text-zinc-700 focus:outline-none"
              >
                <!-- Ikon Mata Terbuka (Show) -->
                <svg
                  id="icon-eye"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                  <circle cx="12" cy="12" r="3" />
                </svg>

                <!-- Ikon Mata Dicoret (Hide) -->
                <svg
                  id="icon-eye-off"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="hidden h-5 w-5"
                >
                  <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
                  <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
                  <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
                  <path d="m2 2 20 20" />
                </svg>
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-kairos-950/20 transition hover:brightness-110 active:scale-[0.99]"
          >
            Masuk
          </button>
        </form>
      </div>

      <!-- Kolom Kanan: Visual Geomembrane & Geotextile (Tampil di layar lg ke atas) -->
      <div class="relative hidden flex-col justify-between overflow-hidden bg-kairos-950 p-8 text-white lg:col-span-6 lg:flex">
        <!-- INI BAGIAN YANG DIGANTI (Foto Unsplash) -->
        <img
          src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1200&q=80"
          alt="Instalasi Geomembrane dan Geotextile Kairos Geo"
          class="absolute inset-0 h-full w-full object-cover object-center opacity-75"
          loading="eager"
          onerror="this.style.display='none'"
        />

        <!-- Pola Tekstil/Grid Halus + Overlay Gradasi agar teks selalu terbaca -->
        <div class="absolute inset-0 hero-grid opacity-30" aria-hidden="true"></div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/55 to-kairos-950/30"
          aria-hidden="true"
        ></div>

        <!-- Badge Atas -->
        <div class="relative z-10">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-white backdrop-blur-md">
            <span class="h-2 w-2 rounded-full bg-kairos-400"></span>
            Geosynthetics Engineering
          </span>
        </div>

        <!-- Informasi Produk di Bagian Bawah Gambar -->
        <div class="relative z-10 rounded-2xl border border-white/10 bg-kairos-950/60 p-5 backdrop-blur-md">
          <h2 class="font-display text-lg font-bold leading-snug text-white">
            Solusi Proteksi &amp; Rekayasa Lahan Terpadu
          </h2>
          <p class="mt-1.5 text-xs leading-relaxed text-zinc-300">
            Pengelolaan data proyek, spesifikasi teknis, dan dokumentasi aplikasi material geosintetik dalam satu dashboard.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-lg bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-zinc-200">
              Geomembrane HDPE
            </span>
            <span class="rounded-lg bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-zinc-200">
              Geotextile Woven &amp; Non-Woven
            </span>
            <span class="rounded-lg bg-white/10 px-2.5 py-1 text-[11px] font-semibold text-zinc-200">
              Geogrid
            </span>
          </div>
        </div>
      </div>

    </div>
  </main>
</AdminLayout>

<script>
  function setupPasswordToggle() {
    const input = document.getElementById("password-input") as HTMLInputElement | null;
    const toggleBtn = document.getElementById("toggle-password");
    const iconEye = document.getElementById("icon-eye");
    const iconEyeOff = document.getElementById("icon-eye-off");

    if (!input || !toggleBtn || !iconEye || !iconEyeOff) return;

    toggleBtn.addEventListener("click", () => {
      const isHidden = input.type === "password";
      input.type = isHidden ? "text" : "password";

      iconEye.classList.toggle("hidden", isHidden);
      iconEyeOff.classList.toggle("hidden", !isHidden);

      toggleBtn.setAttribute("aria-pressed", String(isHidden));
      toggleBtn.setAttribute(
        "aria-label",
        isHidden ? "Sembunyikan password" : "Tampilkan password"
      );
    });
  }

  setupPasswordToggle();
  document.addEventListener("astro:page-load", setupPasswordToggle);
</script>