---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabasePublic } from "../../lib/supabase";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");

const SITE = "https://www.kairosgeo.id";
const slug = Astro.params.slug ?? "";
const now = new Date().toISOString();
const cols =
  "id, title, slug, excerpt, cover_image, thumbnail_alt, published_at, created_at, reading_time, category:categories(name)";

const published = () =>
  supabasePublic
    .from("articles")
    .select(cols)
    .eq("is_published", true)
    .or(`published_at.is.null,published_at.lte.${now}`);

let article: any = null;
let related: any[] = [];

try {
  const { data } = await supabasePublic
    .from("articles")
    .select("*, category:categories(name)")
    .eq("slug", slug)
    .eq("is_published", true)
    .or(`published_at.is.null,published_at.lte.${now}`)
    .maybeSingle();
  article = data;

  if (article) {
    if (article.category_id) {
      const { data: same } = await published()
        .eq("category_id", article.category_id)
        .neq("id", article.id)
        .order("published_at", { ascending: false, nullsFirst: false })
        .limit(3);
      related = same ?? [];
    }
    if (related.length < 3) {
      const exclude = [article.id, ...related.map((r) => r.id)].join(",");
      const { data: latest } = await published()
        .not("id", "in", `(${exclude})`)
        .order("published_at", { ascending: false, nullsFirst: false })
        .limit(3 - related.length);
      related = [...related, ...(latest ?? [])];
    }
  }
} catch {
  article = null;
}

if (!article) Astro.response.status = 404;

const plain = (html: string) =>
  html.replace(/<[^>]*>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();

const formatDate = (d?: string | null) =>
  d ? new Date(d).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }) : "";

const seoTitle = article ? article.meta_title || `${article.title} | Kairos Geo` : "Artikel tidak ditemukan | Kairos Geo";
const seoDescription = article
  ? article.meta_description || article.excerpt || plain(article.content ?? "").slice(0, 155)
  : "Artikel yang Anda cari tidak ditemukan.";
const canonical = article ? article.canonical_url || `${SITE}/artikel/${article.slug}` : "";
const indexable = article ? article.is_indexable !== false : false;

const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.title,
      description: seoDescription,
      image: article.cover_image ? [article.cover_image] : undefined,
      datePublished: article.published_at ?? article.created_at,
      dateModified: article.updated_at ?? article.published_at ?? article.created_at,
      mainEntityOfPage: canonical,
      author: { "@type": "Organization", name: "Kairos Geo" },
      publisher: { "@type": "Organization", name: "Kairos Geo", logo: { "@type": "ImageObject", url: `${SITE}/kairoslogo.png` } },
    }
  : null;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  {article && (
    <Fragment slot="head">
      <link rel="canonical" href={canonical} />
      <meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex, follow"} />
      <meta property="og:type" content="article" />
      <meta property="og:site_name" content="Kairos Geo" />
      <meta property="og:title" content={seoTitle} />
      <meta property="og:description" content={seoDescription} />
      <meta property="og:url" content={canonical} />
      {article.cover_image && <meta property="og:image" content={article.cover_image} />}
      <meta property="article:published_time" content={article.published_at ?? article.created_at} />
      <meta name="twitter:card" content="summary_large_image" />
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    </Fragment>
  )}

  <header class="bg-kairos-950 text-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
      <a href="/" class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center overflow-hidden rounded-full bg-white/10 ring-1 ring-white/15">
          <img src="/kairoslogo.png" alt="Kairos Geo" class="h-full w-full object-cover" />
        </div>
        <span class="font-display text-base font-extrabold tracking-tight">Kairos Geo</span>
      </a>
      <a href="/#artikel" class="text-sm font-bold text-white/80 transition hover:text-white">Artikel</a>
    </div>
  </header>

  {article ? (
    <main class="bg-white">
      <article class="mx-auto max-w-3xl px-4 pb-14 pt-10 sm:px-6 sm:pt-14">
        <header>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-zinc-500">
            {article.category?.name && (
              <span class="rounded-full bg-kairos-100 px-3 py-1 font-bold text-kairos-700">{article.category.name}</span>
            )}
            <time datetime={article.published_at ?? article.created_at}>{formatDate(article.published_at ?? article.created_at)}</time>
            {article.reading_time && <span>· {article.reading_time} menit baca</span>}
          </div>

          <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight tracking-tight text-zinc-950 sm:text-4xl lg:text-[2.6rem]">
            {article.title}
          </h1>
        </header>

        {article.cover_image && (
          <img
            src={article.cover_image}
            alt={article.thumbnail_alt || article.title}
            class="mt-8 aspect-[16/9] w-full rounded-[22px] object-cover"
            loading="eager"
            decoding="async"
          />
        )}

        <div class="article-content mt-8" set:html={article.content}></div>
      </article>

      {related.length > 0 && (
        <section class="border-t border-zinc-200 bg-zinc-50">
          <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
            <h2 class="font-display text-2xl font-extrabold tracking-tight text-zinc-950">Artikel Terkait</h2>

            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((a) => (
                <article class="group flex flex-col overflow-hidden rounded-[22px] border border-zinc-200/80 bg-white shadow-panel">
                  <a href={`/artikel/${a.slug}`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
                    {a.cover_image ? (
                      <img
                        src={a.cover_image}
                        alt={a.thumbnail_alt || a.title}
                        class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="aspect-[16/9] w-full bg-gradient-to-br from-kairos-600 to-kairos-400"></div>
                    )}
                  </a>
                  <div class="flex flex-1 flex-col p-4">
                    <div class="text-xs text-zinc-500">{formatDate(a.published_at ?? a.created_at)}</div>
                    <h3 class="mt-2 line-clamp-2 text-base font-extrabold leading-snug text-zinc-950">
                      <a href={`/artikel/${a.slug}`} class="transition hover:text-kairos-700">{a.title}</a>
                    </h3>
                    {a.excerpt && <p class="mt-2 line-clamp-2 text-sm leading-6 text-zinc-600">{a.excerpt}</p>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}
    </main>
  ) : (
    <main class="mx-auto max-w-xl px-4 py-24 text-center">
      <h1 class="font-display text-3xl font-extrabold text-zinc-950">Artikel tidak ditemukan</h1>
      <p class="mt-3 text-sm text-zinc-600">Artikel yang Anda cari tidak tersedia atau sudah dihapus.</p>
      <a href="/" class="mt-6 inline-flex rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-5 py-3 text-sm font-bold text-white">Kembali ke Beranda</a>
    </main>
  )}

  <footer class="bg-kairos-950 py-6 text-center text-xs text-white/60">
    © {new Date().getFullYear()} Kairos Geo. All rights reserved.
  </footer>
</BaseLayout>

<style is:global>
  .article-content { font-size: 1.0625rem; line-height: 1.85; color: #3f3f46; overflow-wrap: anywhere; }
  .article-content > * + * { margin-top: 1.25rem; }
  .article-content h1,
  .article-content h2,
  .article-content h3 { font-family: "Manrope", "Plus Jakarta Sans", sans-serif; font-weight: 800; line-height: 1.3; color: #18181b; letter-spacing: -0.01em; }
  .article-content h1 { font-size: 1.75rem; margin-top: 2.5rem; }
  .article-content h2 { font-size: 1.5rem; margin-top: 2.25rem; }
  .article-content h3 { font-size: 1.25rem; margin-top: 2rem; }
  .article-content a { color: #7c3aed; text-decoration: underline; text-underline-offset: 3px; }
  .article-content strong { color: #18181b; }
  .article-content ul,
  .article-content ol { padding-left: 1.5rem; }
  .article-content ol { list-style: decimal; }
  .article-content li + li { margin-top: 0.4rem; }
  .article-content li[data-list="bullet"] { list-style-type: disc; }
  .article-content li[data-list="ordered"] { list-style-type: decimal; }
  .article-content .ql-ui { display: none; }
  .article-content .ql-indent-1 { margin-left: 1.5rem; }
  .article-content .ql-indent-2 { margin-left: 3rem; }
  .article-content .ql-indent-3 { margin-left: 4.5rem; }
  .article-content blockquote { border-left: 4px solid #a78bfa; padding: 0.25rem 0 0.25rem 1.1rem; color: #52525b; font-style: italic; }
  .article-content img { max-width: 100%; height: auto; border-radius: 14px; }
  .article-content .ql-align-center { text-align: center; }
  .article-content .ql-align-right { text-align: right; }
  .article-content .ql-align-justify { text-align: justify; }
  @media (max-width: 640px) { .article-content { font-size: 1rem; line-height: 1.8; } }
</style>