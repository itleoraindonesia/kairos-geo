---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/products";

const description =
  "Kairos Geo menyediakan produk geosintetik, konsultasi teknis, dukungan instalasi, dan solusi lingkungan untuk kebutuhan proyek infrastruktur dan pengelolaan air.";

const year = new Date().getFullYear();
const contactWhatsappUrl =
  "https://wa.me/6281292499946?text=Halo%20Kairos%20Geo%2C%20saya%20ingin%20minta%20penawaran%20dan%20konsultasi%20proyek.";
---

<BaseLayout title="Kairos Geo | Geosynthetics & Environmental Solutions" description={description}>
  <div class="min-h-screen">
    <section class="relative overflow-hidden bg-kairos-950 text-white shadow-hero">
      <div class="absolute inset-0 hero-grid opacity-40" aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=2200&q=80');"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-r from-kairos-950 via-kairos-950/78 to-kairos-950/30" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/25 to-kairos-950/60" aria-hidden="true"></div>
      <div class="absolute inset-0 noise-overlay opacity-10 mix-blend-screen" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 pt-4 pb-12 sm:px-6 lg:px-8">
        <header class="flex items-center justify-between gap-6 py-5">
          <a href="/" class="flex items-center gap-3">
            <div class="grid h-11 w-11 place-items-center overflow-hidden rounded-full bg-white/10 ring-1 ring-white/15 backdrop-blur">
              <img src="/Kairoslogo.png" alt="Kairos Geo" class="h-full w-full object-cover" loading="eager" decoding="async" />
            </div>
            <div class="leading-tight">
              <div class="font-display text-lg font-extrabold tracking-tight text-white">Kairos Geo</div>
              <div class="text-[11px] text-white/75">Geosynthetics & Environmental Solutions</div>
            </div>
          </a>

          <nav class="hidden items-center gap-7 text-sm font-semibold text-white/88 lg:flex" aria-label="Primary">
            <a href="#produk" class="transition hover:text-white">Produk</a>
            <a href="#solusi" class="transition hover:text-white">Solusi</a>
            <a href="#proyek" class="transition hover:text-white">Proyek</a>
            <a href="#tentang" class="transition hover:text-white">Tentang Kami</a>
            <a href="#resources" class="transition hover:text-white">Resources</a>
            <a href="#kontak" class="transition hover:text-white">Kontak</a>
          </nav>

          <a
            href={contactWhatsappUrl}
            target="_blank"
            rel="noreferrer"
            class="hidden items-center gap-3 rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-kairos-950/40 transition hover:brightness-110 lg:inline-flex"
          >
            Minta Penawaran
            <ph-arrow-right class="h-4 w-4" size="16" aria-hidden="true"></ph-arrow-right>
          </a>

          <button
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/15 transition hover:bg-white/15 lg:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-mobile-menu-open
          >
            <ph-list class="h-5 w-5 text-white" size="20" aria-hidden="true"></ph-list>
          </button>
        </header>

        <div class="grid gap-12 pb-16 pt-8 mb-8 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:pb-20 lg:pt-12">
          <div class="max-w-3xl">
            <h1 class="font-display text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-[4.1rem] lg:leading-[1.05]">
              Solusi Geosintetik untuk
              <span class="block">Infrastruktur & Lingkungan</span>
            </h1>

            <p class="mt-6 max-w-2xl text-sm leading-7 text-white/80 sm:text-base">
              Kami menyediakan produk geosintetik berkualitas, konsultasi teknis, dan dukungan instalasi untuk proyek containment,
              filtrasi, stabilisasi, dan pengelolaan air.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href={contactWhatsappUrl}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-3 rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-kairos-950/40 transition hover:brightness-110"
              >
                Konsultasi Proyek
                <ph-arrow-right class="h-4 w-4" size="16" aria-hidden="true"></ph-arrow-right>
              </a>

              <a
                href="#resources"
                class="inline-flex items-center gap-3 rounded-xl border border-white/20 bg-white/8 px-5 py-3 text-sm font-bold text-white backdrop-blur transition hover:bg-white/14"
              >
                Download Katalog
                <ph-download-simple class="h-4 w-4" size="16" aria-hidden="true"></ph-download-simple>
              </a>
            </div>
          </div>

          <div class="hidden lg:block">
            <div class="ml-auto max-w-md rounded-[28px] bg-white/8 p-4 backdrop-blur-md">
              <img
                src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1200&q=80"
                alt="Dokumentasi pekerjaan lapangan"
                class="h-[280px] w-full rounded-[22px] object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
                  <div class="font-bold text-white">Support Teknis</div>
                  <div class="mt-1 text-xs leading-5 text-white/70">Bantu spesifikasi sejak tahap perencanaan.</div>
                </div>
                <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
                  <div class="font-bold text-white">QC Proyek</div>
                  <div class="mt-1 text-xs leading-5 text-white/70">Dokumentasi kerja lebih rapi dan terukur.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-px overflow-hidden rounded-[26px] border border-white/10 bg-white/10 backdrop-blur md:grid-cols-2 xl:grid-cols-4">
          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <ph-buildings class="h-5 w-5 text-white" size="20" weight="duotone" aria-hidden="true"></ph-buildings>
              </div>
              <div>
                <div class="text-sm font-bold text-white">Proyek Industri</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Berpengalaman di berbagai sektor industri</div>
              </div>
            </div>
          </div>

          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <ph-chats-circle class="h-5 w-5 text-white" size="20" weight="duotone" aria-hidden="true"></ph-chats-circle>
              </div>
              <div>
                <div class="text-sm font-bold text-white">Dukungan Teknis</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Tim ahli siap membantu sejak tahap perencanaan</div>
              </div>
            </div>
          </div>

          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <ph-truck class="h-5 w-5 text-white" size="20" weight="duotone" aria-hidden="true"></ph-truck>
              </div>
              <div>
                <div class="text-sm font-bold text-white">Pengiriman Nasional</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Jangkauan pengiriman ke seluruh Indonesia</div>
              </div>
            </div>
          </div>

          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <ph-file-doc class="h-5 w-5 text-white" size="20" weight="duotone" aria-hidden="true"></ph-file-doc>
              </div>
              <div>
                <div class="text-sm font-bold text-white">QC Terdokumentasi</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Kualitas terjamin dengan dokumentasi lengkap</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <dialog
        id="mobile-menu"
        class="mobile-menu-dialog text-white"
        aria-label="Mobile navigation"
        data-mobile-menu
      >
        <div class="mobile-menu-panel">
          <div class="border-b border-white/10 px-4 py-4 sm:px-5">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-center gap-3">
                <div class="grid h-10 w-10 place-items-center overflow-hidden rounded-full bg-white/8 ring-1 ring-white/10">
                  <img src="/Kairoslogo.png" alt="Kairos Geo" class="h-full w-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="leading-tight">
                  <div class="font-display text-base font-extrabold tracking-tight">Kairos Geo</div>
                  <div class="mt-1 text-[11px] uppercase tracking-[0.18em] text-white/45">Menu</div>
                </div>
              </div>
            <button
              type="button"
              class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white/6 ring-1 ring-white/10 transition hover:bg-white/10"
              aria-label="Close menu"
              data-mobile-menu-close
            >
              <ph-x class="h-5 w-5" size="20" aria-hidden="true"></ph-x>
            </button>
          </div>

          </div>

          <div class="px-4 pb-4 pt-4 sm:px-5">
            <nav class="grid gap-2" aria-label="Mobile">
              <a class="mobile-menu-link" href="#produk" data-mobile-menu-link>
                <span class="block text-base font-semibold text-white">Produk</span>
                <ph-arrow-right class="mobile-menu-link-icon" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
              <a class="mobile-menu-link" href="#solusi" data-mobile-menu-link>
                <span class="block text-base font-semibold text-white">Solusi</span>
                <ph-arrow-right class="mobile-menu-link-icon" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
              <a class="mobile-menu-link" href="#proyek" data-mobile-menu-link>
                <span class="block text-base font-semibold text-white">Proyek</span>
                <ph-arrow-right class="mobile-menu-link-icon" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
              <a class="mobile-menu-link" href="#tentang" data-mobile-menu-link>
                <span class="block text-base font-semibold text-white">Tentang Kami</span>
                <ph-arrow-right class="mobile-menu-link-icon" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
              <a class="mobile-menu-link" href="#resources" data-mobile-menu-link>
                <span class="block text-base font-semibold text-white">Resources</span>
                <ph-arrow-right class="mobile-menu-link-icon" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
              <a class="mobile-menu-link" href="#kontak" data-mobile-menu-link>
                <span class="block text-base font-semibold text-white">Kontak</span>
                <ph-arrow-right class="mobile-menu-link-icon" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
            </nav>

            <div class="mt-4 border-t border-white/10 pt-4">
              <a class="inline-flex items-center justify-center gap-3 rounded-2xl border border-white/12 bg-white/8 px-4 py-3.5 text-sm font-semibold text-white transition hover:bg-white/12" href={contactWhatsappUrl} target="_blank" rel="noreferrer" data-mobile-menu-link>
                Minta Penawaran
                <ph-arrow-right class="h-4 w-4" size="16" aria-hidden="true"></ph-arrow-right>
              </a>
            </div>
          </div>
        </div>
      </dialog>
    </section>

    <main>
      <!-- Sections below copied from original static HTML with minimal changes -->

      <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <ph-buildings class="h-7 w-7" size="28" weight="fill" aria-hidden="true"></ph-buildings>
              </div>
              <div>
                <div class="font-display text-4xl font-extrabold text-kairos-900">100+</div>
                <div class="text-sm font-bold text-zinc-900">Proyek Didukung</div>
                <div class="text-xs text-zinc-500">Berbagai sektor industri</div>
              </div>
            </div>
          </article>

          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <ph-truck class="h-7 w-7" size="28" weight="fill" aria-hidden="true"></ph-truck>
              </div>
              <div>
                <div class="font-display text-4xl font-extrabold text-kairos-900">20+</div>
                <div class="text-sm font-bold text-zinc-900">Kota Pengiriman</div>
                <div class="text-xs text-zinc-500">Jangkauan seluruh Indonesia</div>
              </div>
            </div>
          </article>

          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <ph-lightning class="h-7 w-7" size="28" weight="fill" aria-hidden="true"></ph-lightning>
              </div>
              <div>
                <div class="text-sm font-bold text-zinc-900">Respon Cepat</div>
                <div class="text-xs text-zinc-500">Tim teknis siap merespon kebutuhan Anda</div>
              </div>
            </div>
          </article>

          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <ph-headset class="h-7 w-7" size="28" weight="fill" aria-hidden="true"></ph-headset>
              </div>
              <div>
                <div class="text-sm font-bold text-zinc-900">Tim Teknis Support</div>
                <div class="text-xs text-zinc-500">Ahli berpengalaman di bidangnya</div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section id="produk" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="h-1 w-20 rounded-full bg-gradient-to-r from-kairos-500 to-kairos-300"></div>
            <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">Produk Utama</h2>
          </div>
          <a href="/produk" class="hidden text-sm font-bold text-kairos-500 transition hover:text-kairos-700 sm:inline-flex">Lihat semua produk -></a>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {products.map((product) => {
            const image = product.images[0] ?? product.heroImageUrl;

            return (
              <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
                <img src={image} alt={product.name} class="h-44 w-full rounded-2xl object-cover" loading="lazy" decoding="async" />
                <h3 class="mt-5 text-lg font-extrabold text-zinc-950">{product.name}</h3>
                <p class="mt-2 text-sm leading-6 text-zinc-600">{product.summary}</p>
                <ul class="mt-4 space-y-2 text-sm text-zinc-700">
                  {product.bullets.slice(0, 3).map((bullet) => <li>- {bullet}</li>)}
                </ul>
                <a href={`/produk/${product.slug}`} class="mt-5 inline-flex text-sm font-bold text-kairos-500 transition hover:text-kairos-700">Lihat Detail -&gt;</a>
              </article>
            );
          })}
        </div>
      </section>

      <section id="solusi" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="h-1 w-20 rounded-full bg-gradient-to-r from-kairos-500 to-kairos-300"></div>
            <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">Solusi Berdasarkan Aplikasi</h2>
          </div>
          <a href="#kontak" class="hidden text-sm font-bold text-kairos-500 transition hover:text-kairos-700 sm:inline-flex">Lihat semua produk -></a>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <article class="group relative overflow-hidden rounded-[28px] bg-kairos-950 text-white shadow-panel">
            <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80" alt="Kolam dan containment" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/35 to-transparent"></div>
            <div class="relative flex min-h-[320px] flex-col justify-end p-6">
              <div class="grid h-12 w-12 place-items-center rounded-full bg-white text-kairos-700 shadow-lg">
                <ph-map-pin-area class="h-5 w-5" size="20" weight="fill" aria-hidden="true"></ph-map-pin-area>
              </div>
              <h3 class="mt-5 text-xl font-extrabold">Kolam & Containment</h3>
              <p class="mt-2 text-sm leading-6 text-white/80">Solusi kedap air untuk kolam limbah, IPAL, dan penampungan cairan.</p>
              <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-white">Pelajari Selengkapnya -></a>
            </div>
          </article>

          <article class="group relative overflow-hidden rounded-[28px] bg-kairos-950 text-white shadow-panel">
            <img src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1200&q=80" alt="Landfill dan tambang" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/35 to-transparent"></div>
            <div class="relative flex min-h-[320px] flex-col justify-end p-6">
              <div class="grid h-12 w-12 place-items-center rounded-full bg-white text-kairos-700 shadow-lg">
                <ph-factory class="h-5 w-5" size="20" weight="fill" aria-hidden="true"></ph-factory>
              </div>
              <h3 class="mt-5 text-xl font-extrabold">Landfill & Tambang</h3>
              <p class="mt-2 text-sm leading-6 text-white/80">Pelapisan landfill, heap leach pad, dan area pertambangan.</p>
              <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-white">Pelajari Selengkapnya -></a>
            </div>
          </article>

          <article class="group relative overflow-hidden rounded-[28px] bg-kairos-950 text-white shadow-panel">
            <img src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=1200&q=80" alt="Erosi dan revegetasi" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/35 to-transparent"></div>
            <div class="relative flex min-h-[320px] flex-col justify-end p-6">
              <div class="grid h-12 w-12 place-items-center rounded-full bg-white text-kairos-700 shadow-lg">
                <ph-leaf class="h-5 w-5" size="20" weight="fill" aria-hidden="true"></ph-leaf>
              </div>
              <h3 class="mt-5 text-xl font-extrabold">Erosi & Revegetasi</h3>
              <p class="mt-2 text-sm leading-6 text-white/80">Pengendalian erosi dan pemulihan lahan dengan vegetasi.</p>
              <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-white">Pelajari Selengkapnya -></a>
            </div>
          </article>

          <article class="group relative overflow-hidden rounded-[28px] bg-kairos-950 text-white shadow-panel">
            <img src="https://images.unsplash.com/photo-1614064641938-3bbee52942c7?auto=format&fit=crop&w=1200&q=80" alt="Drainase dan sumur resapan" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/35 to-transparent"></div>
            <div class="relative flex min-h-[320px] flex-col justify-end p-6">
              <div class="grid h-12 w-12 place-items-center rounded-full bg-white text-kairos-700 shadow-lg">
                <ph-wave-sine class="h-5 w-5" size="20" weight="fill" aria-hidden="true"></ph-wave-sine>
              </div>
              <h3 class="mt-5 text-xl font-extrabold">Drainase & Sumur Resapan</h3>
              <p class="mt-2 text-sm leading-6 text-white/80">Sistem drainase bawah tanah dan sumur resapan yang efisien.</p>
              <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-white">Pelajari Selengkapnya -></a>
            </div>
          </article>
        </div>
      </section>

      <section id="tentang" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div>
          <div class="h-1 w-20 rounded-full bg-gradient-to-r from-kairos-500 to-kairos-300"></div>
          <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">Mengapa Kairos Geo</h2>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <div class="flex items-start gap-4">
              <div class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-kairos-100 text-kairos-700 leading-none">
                <ph-chats-circle size="24" weight="duotone" aria-hidden="true"></ph-chats-circle>
              </div>
              <div>
                <h3 class="text-base font-extrabold text-zinc-950">Konsultasi Teknis</h3>
