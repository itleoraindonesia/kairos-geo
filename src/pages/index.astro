---
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "Kairos Geo menyediakan produk geosintetik, konsultasi teknis, dukungan instalasi, dan solusi lingkungan untuk kebutuhan proyek infrastruktur dan pengelolaan air.";

const year = new Date().getFullYear();
---

<BaseLayout title="Kairos Geo | Geosynthetics & Environmental Solutions" description={description}>
  <div class="min-h-screen">
    <section class="relative overflow-hidden bg-kairos-950 text-white shadow-hero">
      <div class="absolute inset-0 hero-grid opacity-40" aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=2200&q=80');"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-r from-kairos-950 via-kairos-950/78 to-kairos-950/30" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-kairos-950 via-kairos-950/25 to-kairos-950/60" aria-hidden="true"></div>
      <div class="absolute inset-0 noise-overlay opacity-10 mix-blend-screen" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 pt-4 pb-12 sm:px-6 lg:px-8">
        <header class="flex items-center justify-between gap-6 py-5">
          <a href="/" class="flex items-center gap-3">
            <div class="grid h-11 w-11 place-items-center overflow-hidden rounded-full bg-white/10 ring-1 ring-white/15 backdrop-blur">
              <img src="/Kairoslogo.jpg" alt="Kairos Geo" class="h-full w-full object-cover" loading="eager" decoding="async" />
            </div>
            <div class="leading-tight">
              <div class="font-display text-lg font-extrabold tracking-tight text-white">Kairos Geo</div>
              <div class="text-[11px] text-white/75">Geosynthetics & Environmental Solutions</div>
            </div>
          </a>

          <nav class="hidden items-center gap-7 text-sm font-semibold text-white/88 lg:flex" aria-label="Primary">
            <a href="#produk" class="transition hover:text-white">Produk</a>
            <a href="#solusi" class="transition hover:text-white">Solusi</a>
            <a href="#proyek" class="transition hover:text-white">Proyek</a>
            <a href="#tentang" class="transition hover:text-white">Tentang Kami</a>
            <a href="#resources" class="transition hover:text-white">Resources</a>
            <a href="#kontak" class="transition hover:text-white">Kontak</a>
          </nav>

          <a
            href="#kontak"
            class="hidden items-center gap-3 rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-kairos-950/40 transition hover:brightness-110 lg:inline-flex"
          >
            Minta Penawaran
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h12" />
              <path d="M13 6l6 6-6 6" />
            </svg>
          </a>

          <button
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/15 lg:hidden"
            aria-label="Open menu"
            data-mobile-menu-open
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </header>

        <div class="grid gap-12 pb-16 pt-8 mb-8 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:pb-20 lg:pt-12">
          <div class="max-w-3xl">
            <h1 class="font-display text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-[4.1rem] lg:leading-[1.05]">
              Solusi Geosintetik untuk
              <span class="block">Infrastruktur & Lingkungan</span>
            </h1>

            <p class="mt-6 max-w-2xl text-sm leading-7 text-white/80 sm:text-base">
              Kami menyediakan produk geosintetik berkualitas, konsultasi teknis, dan dukungan instalasi untuk proyek containment,
              filtrasi, stabilisasi, dan pengelolaan air.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#kontak"
                class="inline-flex items-center gap-3 rounded-xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-kairos-950/40 transition hover:brightness-110"
              >
                Konsultasi Proyek
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h12" />
                  <path d="M13 6l6 6-6 6" />
                </svg>
              </a>

              <a
                href="#resources"
                class="inline-flex items-center gap-3 rounded-xl border border-white/20 bg-white/8 px-5 py-3 text-sm font-bold text-white backdrop-blur transition hover:bg-white/14"
              >
                Download Katalog
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v12" />
                  <path d="m7 10 5 5 5-5" />
                  <path d="M5 21h14" />
                </svg>
              </a>
            </div>
          </div>

          <div class="hidden lg:block">
            <div class="ml-auto max-w-md rounded-[28px] bg-white/8 p-4 backdrop-blur-md">
              <img
                src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1200&q=80"
                alt="Dokumentasi pekerjaan lapangan"
                class="h-[280px] w-full rounded-[22px] object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
                  <div class="font-bold text-white">Support Teknis</div>
                  <div class="mt-1 text-xs leading-5 text-white/70">Bantu spesifikasi sejak tahap perencanaan.</div>
                </div>
                <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
                  <div class="font-bold text-white">QC Proyek</div>
                  <div class="mt-1 text-xs leading-5 text-white/70">Dokumentasi kerja lebih rapi dan terukur.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-px overflow-hidden rounded-[26px] border border-white/10 bg-white/10 backdrop-blur md:grid-cols-2 xl:grid-cols-4">
          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18" />
                  <path d="M5 21V7l7-4 7 4v14" />
                  <path d="M9 12h.01" />
                  <path d="M15 12h.01" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-white">Proyek Industri</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Berpengalaman di berbagai sektor industri</div>
              </div>
            </div>
          </div>

          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9" />
                  <path d="M12 4h9" />
                  <path d="M3 9h6" />
                  <path d="M3 15h6" />
                  <path d="M9 12h6" />
                  <circle cx="7" cy="9" r="2" />
                  <circle cx="17" cy="12" r="2" />
                  <circle cx="7" cy="15" r="2" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-white">Dukungan Teknis</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Tim ahli siap membantu sejak tahap perencanaan</div>
              </div>
            </div>
          </div>

          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 17h4V5H2v12h3" />
                  <path d="M14 8h4l4 4v5h-4" />
                  <circle cx="7.5" cy="17.5" r="2.5" />
                  <circle cx="17.5" cy="17.5" r="2.5" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-white">Pengiriman Nasional</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Jangkauan pengiriman ke seluruh Indonesia</div>
              </div>
            </div>
          </div>

          <div class="bg-kairos-950/55 px-5 py-6">
            <div class="flex items-start gap-4">
              <div class="grid h-11 w-11 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">
                <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                  <path d="M8 13h8" />
                  <path d="M8 17h5" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-white">QC Terdokumentasi</div>
                <div class="mt-1 text-xs leading-5 text-white/70">Kualitas terjamin dengan dokumentasi lengkap</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <dialog
        class="backdrop:bg-black/60 w-[min(92vw,440px)] rounded-3xl bg-kairos-950 p-0 text-white ring-1 ring-white/10"
        data-mobile-menu
      >
        <div class="p-5">
          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="grid h-10 w-10 place-items-center overflow-hidden rounded-full bg-white/10 ring-1 ring-white/15">
                <img src="/Kairoslogo.jpg" alt="Kairos Geo" class="h-full w-full object-cover" loading="lazy" decoding="async" />
              </div>
              <div class="leading-tight">
                <div class="font-display text-base font-extrabold tracking-tight">Kairos Geo</div>
                <div class="text-[11px] text-white/70">Menu</div>
              </div>
            </div>
            <button
              type="button"
              class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/15"
              aria-label="Close menu"
              data-mobile-menu-close
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 6l12 12" />
                <path d="M18 6l-12 12" />
              </svg>
            </button>
          </div>

          <nav class="mt-5 grid gap-2 text-sm font-semibold" aria-label="Mobile">
            <a class="rounded-2xl bg-white/5 px-4 py-3 ring-1 ring-white/10 hover:bg-white/10" href="#produk" data-mobile-menu-link>Produk</a>
            <a class="rounded-2xl bg-white/5 px-4 py-3 ring-1 ring-white/10 hover:bg-white/10" href="#solusi" data-mobile-menu-link>Solusi</a>
            <a class="rounded-2xl bg-white/5 px-4 py-3 ring-1 ring-white/10 hover:bg-white/10" href="#proyek" data-mobile-menu-link>Proyek</a>
            <a class="rounded-2xl bg-white/5 px-4 py-3 ring-1 ring-white/10 hover:bg-white/10" href="#tentang" data-mobile-menu-link>Tentang Kami</a>
            <a class="rounded-2xl bg-white/5 px-4 py-3 ring-1 ring-white/10 hover:bg-white/10" href="#resources" data-mobile-menu-link>Resources</a>
            <a class="rounded-2xl bg-white/5 px-4 py-3 ring-1 ring-white/10 hover:bg-white/10" href="#kontak" data-mobile-menu-link>Kontak</a>
            <a class="mt-2 inline-flex items-center justify-center gap-3 rounded-2xl bg-gradient-to-r from-kairos-500 to-kairos-400 px-4 py-3 font-extrabold shadow-lg shadow-black/20 hover:brightness-110" href="#kontak" data-mobile-menu-link>
              Minta Penawaran
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h12" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </a>
          </nav>
        </div>
      </dialog>
    </section>

    <main>
      <!-- Sections below copied from original static HTML with minimal changes -->

      <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18" />
                  <path d="M5 21V8h14v13" />
                  <path d="M9 12h.01" />
                  <path d="M15 12h.01" />
                </svg>
              </div>
              <div>
                <div class="font-display text-4xl font-extrabold text-kairos-900">100+</div>
                <div class="text-sm font-bold text-zinc-900">Proyek Didukung</div>
                <div class="text-xs text-zinc-500">Berbagai sektor industri</div>
              </div>
            </div>
          </article>

          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 17h4V5H2v12h3" />
                  <path d="M14 8h4l4 4v5h-4" />
                  <circle cx="7.5" cy="17.5" r="2.5" />
                  <circle cx="17.5" cy="17.5" r="2.5" />
                </svg>
              </div>
              <div>
                <div class="font-display text-4xl font-extrabold text-kairos-900">20+</div>
                <div class="text-sm font-bold text-zinc-900">Kota Pengiriman</div>
                <div class="text-xs text-zinc-500">Jangkauan seluruh Indonesia</div>
              </div>
            </div>
          </article>

          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 3" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-zinc-900">Respon Cepat</div>
                <div class="text-xs text-zinc-500">Tim teknis siap merespon kebutuhan Anda</div>
              </div>
            </div>
          </article>

          <article class="rounded-[24px] border border-zinc-200/80 bg-white p-6 shadow-panel">
            <div class="flex items-center gap-4">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-kairos-100 text-kairos-700">
                <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" />
                  <circle cx="9.5" cy="7" r="4" />
                  <path d="M20 8v6" />
                  <path d="M23 11h-6" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-zinc-900">Tim Teknis Support</div>
                <div class="text-xs text-zinc-500">Ahli berpengalaman di bidangnya</div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section id="produk" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="h-1 w-20 rounded-full bg-gradient-to-r from-kairos-500 to-kairos-300"></div>
            <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">Produk Utama</h2>
          </div>
          <a href="#kontak" class="hidden text-sm font-bold text-kairos-500 transition hover:text-kairos-700 sm:inline-flex">Lihat semua produk -></a>
        </div>

        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src="https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=900&q=80"
              alt="Geomembran"
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <h3 class="mt-5 text-lg font-extrabold text-zinc-950">Geomembran</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600">Lembaran kedap air performa tinggi untuk aplikasi containment.</p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              <li>- Tahan kimia & sinar UV</li>
              <li>- Kedap air & fleksibel</li>
              <li>- Umur layanan panjang</li>
            </ul>
            <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-kairos-500">Lihat Detail -></a>
          </article>

          <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=900&q=80"
              alt="Geotextile"
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <h3 class="mt-5 text-lg font-extrabold text-zinc-950">Geotextile</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600">Non woven & woven geotextile untuk filtrasi, separasi, dan stabilisasi.</p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              <li>- Filtrasi & separasi efektif</li>
              <li>- Perkuatan tanah & stabilisasi</li>
              <li>- Berbagai gramasi tersedia</li>
            </ul>
            <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-kairos-500">Lihat Detail -></a>
          </article>

          <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&w=900&q=80"
              alt="Hydroseeding"
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <h3 class="mt-5 text-lg font-extrabold text-zinc-950">Hydroseeding</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600">Solusi revegetasi cepat untuk stabilisasi lereng dan reklamasi.</p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              <li>- Menstabilkan lereng cepat</li>
              <li>- Mendukung pertumbuhan vegetasi</li>
              <li>- Cocok untuk area luas</li>
            </ul>
            <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-kairos-500">Lihat Detail -></a>
          </article>

          <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src="https://images.unsplash.com/photo-1599707254554-027aeb4deacd?auto=format&fit=crop&w=900&q=80"
              alt="Batu Kapur"
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <h3 class="mt-5 text-lg font-extrabold text-zinc-950">Batu Kapur</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600">Material mineral untuk kebutuhan stabilisasi, penetralan, dan aplikasi konstruksi tertentu.</p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              <li>- Cocok untuk kebutuhan proyek sipil</li>
              <li>- Membantu stabilisasi material dasar</li>
              <li>- Tersedia untuk suplai proyek</li>
            </ul>
            <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-kairos-500">Lihat Detail -></a>
          </article>

          <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src="https://images.unsplash.com/photo-1513828583688-c52646db42da?auto=format&fit=crop&w=900&q=80"
              alt="Modular Tank"
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <h3 class="mt-5 text-lg font-extrabold text-zinc-950">Modular Tank</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600">Sistem modular PP untuk penyimpanan air bersih, limbah, dan drainase.</p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              <li>- Instalasi cepat & modular</li>
              <li>- Kuat & tahan korosi</li>
              <li>- Kapasitas fleksibel</li>
            </ul>
            <a href="#kontak" class="mt-5 inline-flex text-sm font-bold text-kairos-500">Lihat Detail -></a>
          </article>

          <article class="rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=900&q=80"
              alt="Geocell"
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
