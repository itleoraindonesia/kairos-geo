---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../data/products";
---

<BaseLayout
  title="Produk | Kairos Geo"
  description="Daftar produk Kairos Geo: geosintetik untuk containment, filtrasi, stabilisasi, dan pengelolaan air."
>
  <main>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <div class="h-1 w-20 rounded-full bg-gradient-to-r from-kairos-500 to-kairos-300"></div>
          <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-4xl">Produk</h1>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-zinc-600">
            Pilih produk sesuai kebutuhan proyek. Halaman ini scaffold, datanya sementara dan bisa diganti ke katalog asli.
          </p>
        </div>
        <a href="/" class="hidden text-sm font-bold text-kairos-500 transition hover:text-kairos-700 sm:inline-flex">Kembali ke Home -></a>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {products.map((p) => (
          <article class="group rounded-[26px] border border-zinc-200/80 bg-white p-5 shadow-panel">
            <img
              src={p.heroImageUrl}
              alt={p.name}
              class="h-44 w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
            <h2 class="mt-5 text-lg font-extrabold text-zinc-950">{p.name}</h2>
            <p class="mt-2 text-sm leading-6 text-zinc-600">{p.summary}</p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              {p.bullets.map((b) => (
                <li>- {b}</li>
              ))}
            </ul>
            <a href={`/produk/${p.slug}`} class="mt-5 inline-flex text-sm font-bold text-kairos-500 transition group-hover:text-kairos-700">
              Lihat Detail ->
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
